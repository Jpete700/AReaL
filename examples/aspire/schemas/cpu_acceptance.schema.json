{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "aspire-cpu-acceptance-v1"
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "passed": {
      "type": "boolean"
    },
    "scope": {
      "const": "M1 step5 CPU protocol acceptance"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "areal_revision": {
          "type": "string",
          "minLength": 1
        },
        "aspire_revision": {
          "type": "string",
          "minLength": 1
        },
        "source_manifest_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "required": [
        "areal_revision",
        "aspire_revision",
        "source_manifest_sha256"
      ]
    },
    "contract": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "registry_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "lock_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "required": [
        "schema_sha256",
        "registry_sha256",
        "lock_sha256"
      ]
    },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "cpu_only": {
          "const": true
        },
        "synthetic_backend": {
          "const": true
        },
        "neural_inference_run": {
          "const": false
        },
        "generated_code_executed": {
          "const": false
        },
        "optimizer_updates": {
          "const": 0
        }
      },
      "required": [
        "cpu_only",
        "synthetic_backend",
        "neural_inference_run",
        "generated_code_executed",
        "optimizer_updates"
      ]
    },
    "tests": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "passed": {
          "type": "integer",
          "minimum": 0
        },
        "failed": {
          "type": "integer",
          "minimum": 0
        },
        "errors": {
          "type": "integer",
          "minimum": 0
        },
        "skipped": {
          "type": "integer",
          "minimum": 0
        },
        "total": {
          "type": "integer",
          "minimum": 0
        },
        "duration_seconds": {
          "type": "number",
          "minimum": 0
        },
        "junit_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "skip_details": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "testcase": {
                "type": "string",
                "minLength": 1
              },
              "reason": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "testcase",
              "reason"
            ]
          }
        }
      },
      "required": [
        "passed",
        "failed",
        "errors",
        "skipped",
        "total",
        "duration_seconds",
        "junit_sha256",
        "skip_details"
      ]
    },
    "scenarios": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "scenario_id": {
            "type": "string",
            "minLength": 1
          },
          "category": {
            "enum": [
              "failure",
              "retry",
              "cancel",
              "isolation",
              "group",
              "durability",
              "report"
            ]
          },
          "status": {
            "enum": [
              "passed",
              "failed",
              "skipped",
              "missing"
            ]
          },
          "required": {
            "type": "boolean"
          },
          "testcase": {
            "type": "string",
            "minLength": 1
          },
          "reason": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "scenario_id",
          "category",
          "status",
          "required",
          "testcase",
          "reason"
        ]
      },
      "minItems": 1
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "junit": {
          "type": "string",
          "minLength": 1
        },
        "pytest_log": {
          "type": "string",
          "minLength": 1
        },
        "protocol_summary": {
          "type": "string",
          "minLength": 1
        },
        "protocol_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "required": [
        "junit",
        "pytest_log",
        "protocol_summary",
        "protocol_sha256"
      ]
    },
    "protocol": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "passed": {
          "type": "boolean"
        },
        "cases": {
          "type": "integer",
          "minimum": 0
        },
        "episodes": {
          "type": "integer",
          "minimum": 0
        },
        "generation_requests": {
          "type": "integer",
          "minimum": 0
        },
        "durable_rows": {
          "type": "integer",
          "minimum": 0
        },
        "offline_reload_after_shutdown": {
          "type": "boolean"
        }
      },
      "required": [
        "passed",
        "cases",
        "episodes",
        "generation_requests",
        "durable_rows",
        "offline_reload_after_shutdown"
      ]
    },
    "remaining": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1
    }
  },
  "required": [
    "schema_version",
    "generated_at",
    "passed",
    "scope",
    "source",
    "contract",
    "execution",
    "tests",
    "scenarios",
    "evidence",
    "protocol",
    "remaining"
  ],
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
